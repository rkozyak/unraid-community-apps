<?xml version="1.0" encoding="utf-8"?>
<Container version="2">
  <Name>futo-backups</Name>
  <Repository>ghcr.io/futo-org/backups/standalone:v1</Repository>
  <Registry>https://github.com/futo-org/backups/pkgs/container/backups%2Fstandalone</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Project>https://github.com/futo-org/backups</Project>
  <Support>https://docs.futo.cloud/help/troubleshooting</Support>
  <ReadMe>https://github.com/rkozyak/unraid-community-apps#futo-backups</ReadMe>
  <Overview>Encrypted off-site backups for your local files, with or without Immich.</Overview>
  <Category>Backup:</Category>
  <WebUI>http://[IP]:[PORT:22676]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/rkozyak/unraid-community-apps/main/templates/futo-backups.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/futo-org/backups/main/packages/standalone-app/static/favicon.png</Icon>
  <License>https://github.com/futo-org/backups/blob/main/LICENSE</License>
  <Beta>true</Beta>
  <Requires>FUTO Backups beta access, a FUTO account, and consent to diagnostics during setup.</Requires>
  <ExtraSearchTerms>futo yucca restic encrypted backup restore</ExtraSearchTerms>
  <ExtraParams>--restart=always</ExtraParams>
  <Config Name="WebUI" Target="22676" Default="22676" Mode="tcp" Description="" Type="Port" Display="always" Required="true" Mask="false"/>
  <Config Name="Appdata" Target="/data" Default="/mnt/user/appdata/futo-backups/data" Mode="rw" Description="Database, settings, and encryption key" Type="Path" Display="advanced" Required="true" Mask="false"/>
  <Config Name="Cache" Target="/cache" Default="/mnt/user/appdata/futo-backups/cache" Mode="rw" Description="Optional, rebuildable cache" Type="Path" Display="advanced" Required="false" Mask="false"/>
  <Config Name="Backup Source" Target="/target/source" Default="" Mode="ro" Description="Read-only. Add one mount per folder." Type="Path" Display="always" Required="true" Mask="false"/>
  <Config Name="Local Backup Destination" Target="/backends/local" Default="" Mode="rw" Description="Optional local backup storage" Type="Path" Display="advanced" Required="false" Mask="false"/>
  <Config Name="File Walk Concurrency" Target="RESTIC_WALK_CONCURRENCY" Default="64" Mode="" Description="Concurrent file checks" Type="Variable" Display="advanced" Required="false" Mask="false"/>
</Container>
